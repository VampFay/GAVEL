// GAVEL — Prisma schema
// Forensic delivery-to-billing reconciliation tool for dev/IT services firms.
//
// ── Dual-provider strategy (production blocker #1 fix) ─────────────────────
// This file is the SINGLE SOURCE OF TRUTH for models. Its provider is sqlite
// because the dev sandbox and the unit-test suite run on SQLite. Production
// runs PostgreSQL: `scripts/sync-pg-schema.ts` generates the committed
// `prisma/schema.postgres.prisma` (provider swapped, everything else
// identical) and `bun run schema:check` fails CI if the two drift. Real
// migrations live in `prisma/migrations/` (apply with
// `bunx prisma migrate deploy --schema prisma/schema.postgres.prisma`).
// `scripts/generate.ts` picks the right schema for `prisma generate` based
// on the DATABASE_URL protocol, so dev and production each get a client
// bound to their own provider.
//
// Money fields (totalValue, rate, amount, impactAmount, value, total) are
// Decimal(14, 2) — never Float. IEEE-754 floats are the wrong type for
// currency: they drift by fractions of a rupee on sum/multiply, which
// undermines the entire "precision over noise" pitch. Decimal is stored
// as TEXT on SQLite and NUMERIC on Postgres (see Prisma docs).
//
// ── Tenancy (production blocker #2 fix) ────────────────────────────────────
// Every row that carries client data has a REQUIRED `tenantId` FK to Tenant.
// Reads are hard-scoped by the client extension in src/lib/db.ts: cross-
// tenant queries are impossible without an explicit `runUnscoped()`.
// Child rows (contract line items, invoice lines…) carry the tenantId
// redundantly so enforcement never needs a join.
//
// ── Provisioning (production blocker #3 fix) ───────────────────────────────
// User.status ('active'|'disabled') + User.tokenEpoch enable instant session
// revocation: bumping the epoch invalidates every outstanding JWT for that
// user (see src/lib/auth.ts + src/lib/request-principal.ts).
//
// ── Connectors (production blocker #4 fix) ─────────────────────────────────
// ConnectorSource stores per-project live-sync configs (GitHub / Jira).
// Credentials are sealed with AES-256-GCM (src/lib/connectors/crypto.ts) —
// plaintext tokens never touch the database.
//
// ── Multi-instance rate limiting ───────────────────────────────────────────
// RateLimitCounter is the DB-backed store for the limiter
// (src/lib/rate-limit-store.ts) so brute-force protection survives process
// restarts and works behind more than one app instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id // explicit stable ids for demo ('demo-tenant'); cuid for real tenants
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clients           Client[]
  contracts         Contract[]
  changeOrders      ChangeOrder[]
  lineItems         LineItem[]
  milestones        Milestone[]
  exclusions        Exclusion[]
  projects          Project[]
  tickets           Ticket[]
  codeActivities    CodeActivity[]
  timeEntries       TimeEntry[]
  invoices          Invoice[]
  invoiceLines      InvoiceLine[]
  payments          Payment[]
  findings          Finding[]
  findingEvidence   FindingEvidence[]
  monitoredProjects MonitoredProject[]
  driftSnapshots    WeeklyDriftSnapshot[]
  alerts            Alert[]
  auditLogs         AuditLog[]
  connectorSources  ConnectorSource[]
  syncJobs          SyncJob[]
}

model User {
  id           String   @id @default(cuid()) // demo users use stable explicit ids (demo-user-admin, …)
  tenantId     String?
  email        String   @unique
  name         String?
  role         String   @default("viewer") // viewer|reviewer|admin
  passwordHash String?  // scrypt:<salt>:<hash> — null until the invite is accepted
  status       String   @default("active") // active|disabled — disabled blocks login + API at once
  tokenEpoch   Int      @default(0)        // bump to revoke every outstanding JWT for this user
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  reviewedFindings Finding[] @relation("ReviewerFindings")
  acknowledgedAlerts Alert[]  @relation("AcknowledgerAlerts")
  auditLogs    AuditLog[]
  connectorSources ConnectorSource[] @relation("ConnectorCreator")

  @@index([tenantId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Core organizational entities (tenant-scoped)
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  industry     String?
  sizeBand     String?   // e.g. "10-50"
  contactName  String?
  contactEmail String?   @unique
  logoUrl      String?
  deletedAt    DateTime? // soft-delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  contracts    Contract[]
  projects     Project[]
  invoices     Invoice[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([deletedAt])
}

model Contract {
  id              String    @id @default(cuid())
  tenantId        String
  clientId        String
  title           String
  effectiveDate   DateTime
  endDate         DateTime?
  currency        String    @default("INR")
  totalValue      Decimal?  // contract value in `currency`
  rawText         String?   // original SOW text
  status          String    @default("active") // draft|active|expired|terminated
  extractedJson   String?   // LLM-extracted structured payload (JSON string)
  deletedAt       DateTime? // soft-delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems     LineItem[]
  changeOrders  ChangeOrder[]
  milestones    Milestone[]
  exclusions    Exclusion[]
  projects      Project[]
  findings      Finding[]
  invoices      Invoice[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

model ChangeOrder {
  id           String   @id @default(cuid())
  tenantId     String
  contractId   String
  title        String
  description  String
  value        Decimal?
  signedDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

model LineItem {
  id           String   @id @default(cuid())
  tenantId     String
  contractId   String
  description  String
  rate         Decimal? // per-unit price in `currency`
  rateUnit     String? // hour|day|story-point|fixed|month
  quantity     Float?   // count of billable units (not money — keep Float)
  milestone    String?
  deliveryDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@index([milestone])
}

model Milestone {
  id          String   @id @default(cuid())
  tenantId    String
  contractId  String
  externalId  String?  // e.g. "M1"
  description String
  dueDate     DateTime?
  value       Decimal?
  currency    String   @default("INR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@unique([contractId, externalId])
}

model Exclusion {
  id          String   @id @default(cuid())
  tenantId    String
  contractId  String
  clause      String?  // e.g. "5.1"
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery-side records (planned + executed) — tenant-scoped
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  tenantId    String
  clientId    String
  contractId  String?
  name        String
  status      String    @default("active") // active|completed|on_hold
  startDate   DateTime?
  endDate     DateTime?
  deletedAt   DateTime? // soft-delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract      Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  tickets       Ticket[]
  codeActivities CodeActivity[]
  timeEntries   TimeEntry[]
  findings      Finding[]
  monitored     MonitoredProject?
  connectors    ConnectorSource[]

  @@index([tenantId])
  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([deletedAt])
}

model Ticket {
  id           String   @id @default(cuid())
  tenantId     String
  projectId    String
  externalId   String   // e.g. ENG-204
  title        String
  type         String?  // story|bug|task|epic
  status       String   // todo|in_progress|done|closed
  assignee     String?
  // NOTE: `externalCreated`/`externalUpdated` mirror the upstream system's
  // timestamps; `createdAt`/`updatedAt` are Prisma's own. The previous
  // collision (`created`/`updated` + `createdAt`) is gone.
  externalCreated DateTime?
  externalUpdated DateTime?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@unique([projectId, externalId])
}

model CodeActivity {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  type        String   // commit|pr|merge|deploy
  ref         String   // commit sha or PR number
  title       String
  author      String
  timestamp   DateTime
  additions   Int?
  deletions   Int?
  filesChanged Int?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([projectId, timestamp])
}

model TimeEntry {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  externalId  String?  // upstream id from Toggl/Harvest/etc.
  assignee    String?
  description String?
  hours       Float?
  loggedAt    DateTime
  source      String?  // toggl|harvest|jira|manual
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([projectId, loggedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing-side records — tenant-scoped
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  contractId   String?
  number       String
  issueDate    DateTime
  dueDate      DateTime?
  status       String    @default("issued") // draft|issued|paid|overdue|void
  total        Decimal
  currency     String    @default("INR")
  deletedAt    DateTime? // soft-delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([tenantId])
  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([number])
  @@index([deletedAt])
}

model InvoiceLine {
  id           String   @id @default(cuid())
  tenantId     String
  invoiceId    String
  description  String
  amount       Decimal
  periodStart  DateTime?
  periodEnd    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  amount      Decimal
  currency    String   @default("INR")
  paidAt      DateTime
  method      String?  // bank_transfer|card|cheque|upi
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paidAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Findings — the core artifact (tenant-scoped)
// ─────────────────────────────────────────────────────────────────────────────

model Finding {
  id              String    @id @default(cuid())
  tenantId        String
  contractId      String?
  projectId       String?
  type            String    // missed_milestone|unbilled_overage|scope_expansion|rate_discrepancy|unauthorized_work
  // Deterministic engine idempotency key, e.g. "missed_milestone:<contractId>:<milestoneExternalId>".
  // The reconcile route upserts by this key — NOT by (type, title), which breaks
  // whenever a rule's generated title wording changes (audit v2, finding #1).
  // Cross-tenant collision is impossible: signatures embed contract/project ids,
  // which are globally unique. Null = manually-created finding.
  signature       String?   @unique
  title           String
  summary         String
  impactAmount    Decimal?  // INR value at stake
  confidence      String    // HIGH|MEDIUM|LOW
  confidenceScore Float?    // 0.0-1.0 composite (NOT money — keep Float)
  // Per-pillar sub-scores { contract, delivery, authorization, billing } as a
  // JSON string — "decomposed, not magical" (§9.4; audit v2, finding #2).
  // Kept String for SQLite/Postgres dual-provider parity; revisit with a
  // dedicated Json column if a provider split ever lands.
  confidenceBreakdown String?
  assessment      String    // billable|already_covered|ambiguous
  recommendedAction String  // approve|dismiss|request_review|draft_change_order
  status          String    @default("pending_review") // pending_review|approved|dismissed|escalated
  contractClause  String?
  billingState    String?
  reviewNotes     String?
  deletedAt       DateTime? // soft-delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewedAt      DateTime?
  reviewedById    String?   // FK to User (was: reviewedBy String?)

  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  contract      Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reviewer      User?      @relation("ReviewerFindings", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence      FindingEvidence[]

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([contractId])
  @@index([projectId])
  @@index([reviewedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model FindingEvidence {
  id           String   @id @default(cuid())
  tenantId     String
  findingId    String
  evidenceType String   // contract_clause|delivery_record|billing_record|supporting|contradicting
  source       String   // sow|jira|github|gitlab|invoice|change_order
  refId        String?  // id of the linked record in source system
  title        String
  detail       String?
  timestamp    DateTime?
  weight       Float?   // contribution to confidence score
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  finding  Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([findingId])
  @@index([source])
}

// ─────────────────────────────────────────────────────────────────────────────
// Continuous monitoring (Phase 3) — tenant-scoped
// ─────────────────────────────────────────────────────────────────────────────

model MonitoredProject {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String   @unique
  startedAt   DateTime @default(now())
  alertsEnabled Boolean @default(true)
  driftBaseline Float?  // expected delivery-to-billing ratio
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alerts        Alert[]
  driftSnapshots WeeklyDriftSnapshot[]
}

model WeeklyDriftSnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  monitoredProjectId String
  weekStart       DateTime
  deliveryHours   Float
  billedHours     Float
  ratio           Float
  zScore          Float?
  createdAt       DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  monitoredProject MonitoredProject @relation(fields: [monitoredProjectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([monitoredProjectId, weekStart])
  @@index([monitoredProjectId, weekStart])
}

model Alert {
  id          String   @id @default(cuid())
  tenantId    String
  monitoredProjectId String
  severity    String   // info|warning|critical
  category    String   // scope_creep|milestone_gap|billing_drift|rate_risk
  message     String
  acknowledged Boolean @default(false)
  acknowledgedAt DateTime?
  acknowledgedById String?  // FK to User
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  monitoredProject MonitoredProject  @relation(fields: [monitoredProjectId], references: [id], onDelete: Cascade)
  acknowledger     User?             @relation("AcknowledgerAlerts", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([monitoredProjectId])
  @@index([createdAt])
  @@index([acknowledged])
}

// ─────────────────────────────────────────────────────────────────────────────
// Live connectors (GitHub / Jira) — production blocker #4 fix.
// Credentials are AES-256-GCM sealed (src/lib/connectors/crypto.ts); only the
// sealed blob ever persists. `config` is a JSON string of non-secret fields
// (owner/repo, JQL, host…) validated per-kind by zod at the API boundary.
// ─────────────────────────────────────────────────────────────────────────────

model ConnectorSource {
  id                String    @id @default(cuid())
  tenantId          String
  projectId         String
  kind              String    // github|jira
  config            String    // JSON: non-secret per-kind config
  credentialsSealed String?   // enc:v1:<iv>:<tag>:<ct> — AES-256-GCM
  lastSyncAt        DateTime?
  lastSyncStatus    String?   // ok|error
  lastSyncSummary   String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User?    @relation("ConnectorCreator", fields: [createdById], references: [id], onDelete: SetNull)
  jobs     SyncJob[]

  @@index([tenantId])
  @@index([projectId])
  @@unique([projectId, kind])
}

// WP 1.2 — asynchronous connector sync pipeline (BullMQ + Redis).
// One row per enqueued sync: the queue job's database-side mirror and the
// single source of truth for progress reporting (SSE + polling read this;
// the queue itself is ephemeral).
model SyncJob {
  id           String           @id @default(cuid())
  tenantId     String
  connector    ConnectorSource  @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  connectorId  String
  status       String           // queued | active | completed | failed
  attempts     Int              @default(0)
  error        String?
  stats        String?          // JSON: { fetched, committed, apiCalls, truncated }
  requestedBy  String           // actor email at enqueue time
  requestId    String?          // correlation id of the enqueue request
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, connectorId, createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-instance rate limiting — companion to src/lib/rate-limit-store.ts.
// Fixed-window counters keyed (key, windowStart). The sliding behaviour is
// approximated by weighting the previous window (see the store's docs).
// ─────────────────────────────────────────────────────────────────────────────

model RateLimitCounter {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([key, windowStart])
  @@index([windowStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Immutable audit log — every access, review, export, finding action.
// Immutability is enforced at the Prisma-client layer via an `extends`
// client extension in src/lib/db.ts (blocks update/delete on this model).
// Tenant-stamped so each tenant's trail is visible to that tenant only,
// while remaining append-only for everyone.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorId     String?  // FK to User (null = unauthenticated/system)
  actor       String   // email string (kept for backward compat; prefer actorId)
  action      String   // view|review|approve|dismiss|escalate|export|extract|seed|ingest|connector_sync|account_activated
  entityType  String?
  entityId    String?
  detail      String?
  requestId   String?  // correlation id from middleware
  createdAt   DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actorUser  User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actor])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([requestId])
}
