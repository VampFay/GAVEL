# GAVEL — production environment template
#
# Copy to your deployment's env store (never commit the filled-in file):
#   cp .env.production.example .env.production   # or paste into your PaaS
#
# All vars are validated at startup by src/lib/env.ts (zod, fail-fast).
# See docs/DEPLOYMENT.md for the full runbook. Lines below marked REQUIRED
# must be set before the first request is served.

# ── Data layer ──────────────────────────────────────────────────────────────
# REQUIRED. Managed PostgreSQL strongly recommended (Neon / Supabase / RDS).
# Managed providers default to TLS; keep sslmode=require.
# The Prisma client bound to PostgreSQL is generated at install time based
# on this URL's protocol (scripts/generate.ts).
DATABASE_URL=postgresql://gavel_app:password@host:5432/gavel?sslmode=require

# REQUIRED for migrations + system CLI (migrate:deploy:owner, crypto:rotate,
# create-tenant, seed). Connects as the TABLE OWNER (gavel_owner) — the role
# that bypasses RLS. NEVER provide this to the web process; the runtime uses
# gavel_app (DATABASE_URL above), which is fully RLS-constrained. See
# docs/DEPLOYMENT.md §Roles for provisioning on managed providers.
OWNER_DATABASE_URL=postgresql://gavel_owner:password@host:5432/gavel?sslmode=require

# ── Secrets ─────────────────────────────────────────────────────────────────
# REQUIRED. Signs the session cookie (HS256). The server refuses to serve
# auth traffic without it (>= 32 chars; a shorter value is rejected).
#   openssl rand -hex 32
GAVEL_JWT_SECRET=replace-with-openssl-rand-hex-32

# AES-256-GCM key material that seals saved connector credentials
# (GitHub tokens, Jira PATs) at rest. Falls back to GAVEL_JWT_SECRET when
# unset — acceptable for single-tenant pilots, but rotating one then
# invalidates the other. Set explicitly, and different from the JWT secret:
#   openssl rand -hex 32
GAVEL_CONNECTOR_SECRET=replace-with-a-different-openssl-rand-hex-32

# ── Credential key rotation (WP 1.4) ────────────────────────────────────────
# Zero-downtime rotation runbook:
#   1. Set the NEW secret in GAVEL_CONNECTOR_SECRET above; move the OLD
#      secret here; bump GAVEL_CONNECTOR_KEY_VERSION (2 for the first
#      rotation). Deploy — mixed-version fleets keep reading every envelope
#      (each carries its key version).
#   2. bun run crypto:rotate          # re-seals every stored credential
#      (add --dry-run to preview, --verify to round-trip-check each row)
#   3. Remove GAVEL_CONNECTOR_SECRET_PREVIOUS. Rotation complete.
# GAVEL_CONNECTOR_SECRET_PREVIOUS=the-old-openssl-rand-hex-32
# GAVEL_CONNECTOR_KEY_VERSION=2

# ── Auth posture ────────────────────────────────────────────────────────────
# Strict auth is enforced whenever NODE_ENV=production. Set this to 'true'
# on deploy targets whose NODE_ENV you do not trust (containers, some PaaS
# build steps) — it forces the strict production behavior regardless.
GAVEL_REQUIRE_AUTH=true

# Demo-data self-heal (restores demo users/dataset when the DB is empty).
# Dev/test convenience — hard-disabled in production; set 'false' to be
# explicit about it. Real tenants are provisioned via
# scripts/create-tenant.ts, never by the seeder.
GAVEL_AUTO_SEED_DEMO=false

# ── Async connector sync (WP 1.2) ───────────────────────────────────────────
# REQUIRED for queue mode. Redis for the BullMQ connector-sync queue.
# With it set: POST /api/connectors/:id/sync enqueues (202 + jobId) and a
# separate worker process executes — large repo/Jira pulls can no longer
# hit route timeouts. Run the worker alongside the web process:
#   bun run worker
# WITHOUT it: the sync route executes inline (same code path, dev fallback).
REDIS_URL=redis://redis.internal:6379

# Force a mode regardless of Redis: queue | inline. (Unset = auto: queue
# when REDIS_URL is present, inline otherwise.)
# GAVEL_SYNC_MODE=queue

# ── Rate limiting ───────────────────────────────────────────────────────────
# 'db' shares the fixed-window counters across instances and survives
# restarts (production default); 'memory' is single-process only.
GAVEL_RATE_LIMIT_STORE=db

# ── Public (client-visible) ────────────────────────────────────────────────
# Canonical public URL — used for absolute links and future OAuth callbacks.
NEXT_PUBLIC_APP_URL=https://gavel.yourdomain.com

# Demo-data reseed button. The backing /api/seed route returns 404 in
# production regardless; leave 'false' so the button stays hidden too.
# Set 'true' ONLY for a throwaway public demo deployment.
NEXT_PUBLIC_ENABLE_RESEED=false

# ── Runtime ────────────────────────────────────────────────────────────────
# Set by your platform in most cases; set it explicitly in raw containers.
NODE_ENV=production

# ── System diagnostics (health ?deep=1) ────────────────────────────────────
# OPTIONAL, single purpose: lets the deep health probe report platform-wide
# counts through the owner connection. Leave unset on hosts where you do not
# want any owner-connection in the web process.
# GAVEL_ALLOW_SYSTEM_DB=true
