# ShipLedger environment configuration
# Copy to `.env` and adjust. All vars are validated in src/lib/env.ts
# (zod schema, fail-fast at startup) — vars not listed there are not
# sanctioned and must not be read directly from process.env.

# ── Required ────────────────────────────────────────────────────────────────
# SQLite in dev. Prisma resolves relative paths against prisma/schema.prisma,
# so `file:../db/custom.db` points at <repo>/db/custom.db.
# (Postgres migration pending: swap for postgresql://… when it lands.)
DATABASE_URL=file:../db/custom.db

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT signing secret for the session cookie (HS256). REQUIRED in production:
# the server refuses to start without it (>= 32 chars). In development an
# insecure deterministic fallback is used and a loud warning is logged.
# Generate one:  openssl rand -hex 32
# Leave commented out locally (dev has a loud-warned fallback secret).
# SHIPLEDGER_JWT_SECRET=replace-with-64-hex-chars

# Fail-safe (audit v2 finding #3): set to 'true' to force strict production
# auth behavior regardless of NODE_ENV — use on deploy targets that don't
# reliably set NODE_ENV=production.
SHIPLEDGER_REQUIRE_AUTH=false

# ── Optional ────────────────────────────────────────────────────────────────
# Canonical public URL (used for absolute links / OAuth callbacks later).
# Leave commented out if not needed yet.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Allow the demo-data reseed endpoint (dev convenience; keep false in prod).
NEXT_PUBLIC_ENABLE_RESEED=false
